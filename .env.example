DATABASE_URL="postgresql://redline:redline@localhost:5432/redline"
APP_URL="http://localhost:3000"
# "sandbox" (development only, never moves real money; refused when NODE_ENV=production) or "stripe"
PAYMENTS_PROVIDER="sandbox"
# Stripe (server-side only; never prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Where message attachments are stored (defaults to ./storage/attachments; use /tmp/attachments on Vercel)
UPLOAD_DIR=""
# Test deployments only: lets sandbox (fake) payments run in production mode. Never set on a live site.
ALLOW_SANDBOX_IN_PRODUCTION=""
# Test deployments only: also create the demo customer/provider accounts in production
SEED_DEMO=""
# Admin account created by `npm run db:seed` (required in production)
ADMIN_EMAIL="admin@redline.local"
ADMIN_PASSWORD=""
